" Default search engine
set searchengine duckduckgo

" Custom search engines (mirrors Firefox search config)
set searchurls.np https://search.nixos.org/packages?channel=unstable&query=%s
set searchurls.no https://search.nixos.org/options?channel=unstable&query=%s
set searchurls.hm https://home-manager-options.extranix.com/?query=%s&release=master
set searchurls.gh https://github.com/search?q=%s&type=repositories
set searchurls.mdn https://developer.mozilla.org/en-US/search?q=%s
set searchurls.cr https://crates.io/search?q=%s
set searchurls.rs https://docs.rs/releases/search?query=%s
set searchurls.yt https://www.youtube.com/results?search_query=%s
set searchurls.w https://en.wikipedia.org/wiki/Special:Search?search=%s
