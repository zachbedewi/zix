root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.nix]
indent_style = space
indent_size = 2

[*.lua]
indent_style = space
indent_size = 4

[justfile]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[flake.lock]
indent_style = unset
indent_size = unset
